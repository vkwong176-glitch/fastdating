rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /subscription_receipts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    /// 提議活動方案宣傳圖（[EventProposalService]：`event_proposals/{uid}/{docId}.jpg`）
    match /event_proposals/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    /// 後台活動 CMS 宣傳圖（[AdminBackendService.uploadEventCmsImage]：`event_cms/{docId}/promo.jpg`）
    match /event_cms/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    /// 廣告合作貼文圖（[SubscriptionOrderService]：`ad_coop_post_images/{uid}/…`）
    match /ad_coop_post_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    /// 無訂單時獨立上傳（[SubscriptionOrderService.uploadStandaloneAdCoopPostImage]）
    match /ad_coop_standalone_posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
